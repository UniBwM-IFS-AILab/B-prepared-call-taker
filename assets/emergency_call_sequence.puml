@startuml emergency_call_sequence
actor User
participant "System" as S
participant "RD1-Classifier" as A
participant "RD2-Classifier" as B

== First Question ==
User -> S : Question 1
par Classify Answer
    S -> A : Forward Answer
    S -> B : Forward Answer
end
S -> User : Answer

== Second Question ==
User -> S : Question 2
par Classify Answer
    S -> A : Forward Answer
    S -> B : Forward Answer
end
S -> User : Answer 2

== Continue as needed ==
User -> S : Question N
par Classify each Answer
    S -> A : Forward Answer
    S -> B : Forward Answer
end
S -> User : Answer N

@enduml
